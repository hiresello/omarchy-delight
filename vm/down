#!/bin/bash

# Power the VM off. Snapshots survive; the next vm/up restores "fresh".
#
#   vm/down              shut down (falls back to QEMU quit after 30s)
#   vm/down --destroy    also delete the machine and its snapshots (not the image)

set -euo pipefail
# shellcheck source=vm/lib/host.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/host.sh"

destroy=0
case ${1:-} in
  '') ;;
  --destroy) destroy=1 ;;
  -h | --help)
    sed -n '3,6p' "$0"
    exit 0
    ;;
  *) vm_die "unknown argument: $1" 2 ;;
esac

if vm_running; then
  vm_log "shutting down"
  vm_stop
fi
if ((destroy)); then
  rm -rf "$VM_MACHINE"
  vm_log "machine deleted; the image stays in $VM_HOME/images"
fi
