#!/bin/bash

# Run every VM test in the guest and aggregate their TAP:
# modules/*/tests/vm-*.sh, tests/e2e/vm-*.sh and vm/tests/vm-*.sh (or the
# files given). Each file starts from the state the VM was in when run-all
# began (an internal snapshot), unless --no-isolate.
#
#   vm/run-all [--no-isolate] [file...]
#
# Writes vm/out/<timestamp>/tap/{<test>.tap,all.tap}, a closing screenshot per
# test in screenshots/, and journals in logs/. Exits 1 if any test failed.

set -euo pipefail
# shellcheck source=vm/lib/host.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/host.sh"

isolate=1
files=()
for arg in "$@"; do
  case $arg in
    --no-isolate) isolate=0 ;;
    -h | --help)
      sed -n '3,11p' "$0"
      exit 0
      ;;
    *) files+=("$arg") ;;
  esac
done
if ((${#files[@]} == 0)); then
  mapfile -t files < <(cd "$VM_REPO" && for g in 'modules/*/tests/vm-*.sh' 'tests/e2e/vm-*.sh' 'vm/tests/vm-*.sh'; do compgen -G "$g" || true; done | sort)
  files=("${files[@]/#/$VM_REPO/}")
fi

vm_require_running
vm_out_init
all=$VM_OUT/tap/all.tap
if ((${#files[@]} == 0)); then
  echo "1..0 # SKIP no VM tests found" | tee "$all"
  exit 0
fi

t0=$(vm_secs)
vm_push_lib
base=run-all-$$
if ((isolate)); then
  vm_snapshot_save "$base"
fi
vm_sh "cat ~/.local/state/delight-vm/installed 2>/dev/null || echo 'not installed'" </dev/null >"$VM_OUT/logs/installed-ref.txt"

{
  echo "TAP version 13"
  echo "1..${#files[@]}"
} >"$all"
n=0 failed=0
for file in "${files[@]}"; do
  n=$((n + 1))
  slug=$(vm_slug "$file")
  rel=$(realpath -m --relative-to="$VM_REPO" "$file")
  if ((isolate && n > 1)); then
    vm_snapshot_load "$base"
    vm_push_lib
  fi
  vm_log "[$n/${#files[@]}] $rel"
  started=$(vm_secs)
  rc=0
  vm_run_script "$file" >"$VM_OUT/tap/$slug.tap" 2>"$VM_OUT/logs/$slug.stderr" || rc=$?
  vm_screenshot_to "$VM_OUT/screenshots/$slug.png" || true
  verdict=ok note=""
  if ((rc != 0)) || grep -E '^not ok' "$VM_OUT/tap/$slug.tap" | grep -viq '# *todo'; then
    verdict="not ok" note=" # exit $rc"
    failed=$((failed + 1))
    vm_guest 'journalctl --user -b --no-pager -n 500' </dev/null >"$VM_OUT/logs/$slug.journal" 2>&1 || true
  fi
  {
    echo "# Subtest: $rel"
    sed 's/^/    /' "$VM_OUT/tap/$slug.tap"
    echo "$verdict $n - $rel$note"
  } >>"$all"
  vm_log "$verdict $rel ($(($(vm_secs) - started))s)"
done

vm_guest 'journalctl --user -b --no-pager' </dev/null >"$VM_OUT/logs/journal-user.log" 2>&1 || true
vm_sh 'sudo -n journalctl -b -p warning --no-pager' </dev/null >"$VM_OUT/logs/journal-warnings.log" 2>&1 || true
cp "$VM_MACHINE/serial.log" "$VM_OUT/logs/serial.log" 2>/dev/null || true
if ((isolate)); then
  vm_snapshot_load "$base"
  vm_snapshot_delete "$base" || true
fi

echo "# $((n - failed))/$n test files passed in $(($(vm_secs) - t0))s" >>"$all"
cat "$all"
vm_log "results: $VM_OUT"
((failed == 0))
