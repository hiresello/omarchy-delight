# The Omarchy VM image the harness boots (sourced by vm/lib/host.sh).
# A sealed image of the latest stable release, published by omacom/omarchy-iso's
# nightly build after an unattended install and its acceptance checks. Bump all
# fields together from https://nightly.omarchy.org/stable/latest.json and the
# SHA256SUMS in its vm.unpacked folder.

VM_IMAGE_CHANNEL=stable
VM_IMAGE_VERSION=4.0.4
VM_IMAGE_URL=https://nightly.omarchy.org/stable/4.0.4/440/omarchy-4.0.4.qcow2
VM_IMAGE_SHA256=43412b896fe3d730e373a51a8acf99343d7c3e6dee78aa9f9bd7fca181127264
VM_IMAGE_UNPACKED=https://nightly.omarchy.org/stable/4.0.4/440/unpacked/
VM_IMAGE_VMLINUZ_SHA256=729245e880036266d0bb8dd1993229dfc4a4ce7e3a5ae25384f9f5e046911df0
VM_IMAGE_INITRD_SHA256=c013103086c064ef39b309b02cbab5eb8b52f1c1cafdd571819c90e5ffe7a88a
VM_IMAGE_CMDLINE_SHA256=bc601ba4ce66f35fc69615849192ef95c4100750434ec671a0fb784d40801fe5
