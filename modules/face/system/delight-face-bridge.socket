[Unit]
Description=On-demand listener for the IR face bridge
Documentation=https://github.com/hiresello/omarchy-delight
# Listening does not open the HM1092 and does not light the privacy LED.

[Socket]
ListenStream=/run/omarchy-delight/face-bridge.sock
SocketMode=0660
SocketGroup=video
DirectoryMode=0755
Accept=yes
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
