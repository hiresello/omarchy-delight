#!/bin/bash

printf 'busctl %s\n' "$*" >>"${DELIGHT_STUB_LOG:-/dev/null}"
[[ ${DELIGHT_PHONE_NO_DAEMON:-false} == "true" ]] && exit 1

fixture="${DELIGHT_PHONE_FIXTURE:?DELIGHT_PHONE_FIXTURE is required}"
while [[ ${1:-} == --* ]]; do
  shift
done
mode="${1:-}"
shift || true

case "$mode" in
  get-property)
    service="$1"
    object_path="$2"
    interface="$3"
    property="$4"
    if [[ ${DELIGHT_PHONE_NO_REACHABLE:-false} == "true" && $property == "isReachable" ]]; then
      printf '{"type":"b","data":[false]}\n'
      exit 0
    elif [[ $object_path == */notifications/* && ${DELIGHT_PHONE_SILENT:-false} == "true" && $property == "silent" ]]; then
      printf '{"type":"b","data":[true]}\n'
      exit 0
    elif [[ $object_path == */notifications/* ]]; then
      jq -c --arg property "$property" '
        .notificationProperties[$property] // empty
      ' "$fixture"
    elif [[ $service == "org.freedesktop.Notifications" ]]; then
      jq -c --arg property "$property" '.notificationProperties[$property] // empty' "$fixture"
      exit $?
    fi
    if [[ $object_path == /modules/kdeconnect ]]; then
      jq -c --arg property "$property" '.daemonProperties[$property] // empty' "$fixture"
      exit $?
    fi
    device=$(sed -nE 's#^/modules/kdeconnect/devices/([^/]+)(/.*)?$#\1#p' <<<"$object_path")
    jq -c --arg device "$device" --arg property "$property" '
      .devices[$device][$property] // empty
    ' "$fixture"
    ;;
  call)
    service="$1"
    object_path="$2"
    interface="$3"
    method="$4"
    signature="${5:-}"
    first="${6:-}"
    second="${7:-}"
    case "$method" in
      devices)
        if [[ ${DELIGHT_PHONE_NO_REACHABLE:-false} == "true" && $first == "true" ]]; then
          printf '{"type":"as","data":[]}\n'
        elif [[ $first == "true" && $second == "false" ]]; then
          jq -c '.calls.devices_discoverable' "$fixture"
        elif [[ $first == "true" ]]; then
          jq -c '.calls.devices_reachable' "$fixture"
        else
          jq -c '.calls.devices_paired' "$fixture"
        fi
        ;;
      deviceNames)
        if [[ $first == "true" && $second == "false" ]]; then
          jq -c '.calls.names_discoverable' "$fixture"
        elif [[ $first == "true" ]]; then
          jq -c '.calls.names_reachable' "$fixture"
        else
          jq -c '.calls.names_paired' "$fixture"
        fi
        ;;
      announcedName | selfId | pairingRequests)
        jq -c --arg method "$method" '.daemonProperties[$method]' "$fixture"
        ;;
      loadedPlugins)
        device=$(sed -nE 's#^/modules/kdeconnect/devices/([^/]+)(/.*)?$#\1#p' <<<"$object_path")
        jq -c --arg device "$device" '.devices[$device].loadedPlugins' "$fixture"
        ;;
      activeConversations)
        jq -c '.calls.active_conversations' "$fixture"
        ;;
      requestAllConversationThreads | requestConversation | requestPairing | acceptPairing | cancelPairing | setPluginEnabled | sendClipboard | dismiss)
        printf '{"type":"()","data":[]}\n'
        ;;
      CloseNotification)
        printf '{"type":"()","data":[]}\n'
        ;;
      *)
        printf '{"type":"()","data":[]}\n'
        ;;
    esac
    ;;
  monitor)
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
