#!/bin/bash

set -euo pipefail

mkdir -p -- "$XDG_RUNTIME_DIR" "$HOME/Downloads"
chmod 700 "$XDG_RUNTIME_DIR"

exec dbus-run-session -- bash -c '
  set -euo pipefail
  printf "%s\n" "$DBUS_SESSION_BUS_ADDRESS" > /tmp/phone-e2e-dbus-address
  sway -c /etc/sway/config > "/artifacts/sway-$HOSTNAME.log" 2>&1 &
  for _ in {1..100}; do
    [[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]] && break
    sleep 0.1
  done
  mako > "/artifacts/mako-$HOSTNAME.log" 2>&1 &
  QT_FORCE_STDERR_LOGGING=1 kdeconnectd > "/artifacts/kdeconnectd-$HOSTNAME.log" 2>&1 &
  wait
'
