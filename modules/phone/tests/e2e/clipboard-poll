#!/bin/bash

set -euo pipefail

expected="$1"
start_ms=$(date +%s%3N)
deadline_ms=$((start_ms + 2000))
while (($(date +%s%3N) < deadline_ms)); do
  if [[ $(wl-paste --no-newline 2>/dev/null || true) == "$expected" ]]; then
    printf 'PASS %s\n' "$(($(date +%s%3N) - start_ms))"
    exit 0
  fi
  sleep 0.01
done
printf 'FAIL >2000\n'
exit 1
