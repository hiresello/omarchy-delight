#!/bin/bash

# Fake Sunshine web API. Reads the curl config from stdin like the real call.
cfg=$(cat)
method=GET body=""
while (($# > 0)); do
  case "$1" in
    -X) method="$2"; shift ;;
    --data-binary) body="$2"; shift ;;
  esac
  shift
done
url=$(sed -nE 's/^url = "(.*)"$/\1/p' <<<"$cfg")
user=$(sed -nE 's/^user = "([^:]*):.*"$/\1/p' <<<"$cfg")
printf 'curl %s %s user=%s %s\n' "$method" "$url" "$user" "$body" >>"${DELIGHT_STUB_LOG:-/dev/null}"
case "$method ${url##*/api}" in
  "GET /pin")
    [[ ${SIDECAR_STUB_LEGACY:-} == 1 ]] && exit 22
    if [[ ${SIDECAR_STUB_PIN_FAIL:-} == 1 ]]; then
      echo '{"status_code":401,"error":"Unauthorized"}'
      exit 22
    fi
    echo '{"pairings":[{"id":"0123456789abcdef0123456789abcdef","name":"iPad","address":"192.168.1.20"}]}'
    ;;
  "POST /pin")
    if [[ $body == *'"pin":"1234"'* ]]; then echo '{"status":true}'; else echo '{"status":false}'; fi
    ;;
  *) exit 22 ;;
esac
