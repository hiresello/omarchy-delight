{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hiresello/omarchy-delight/schema/status.schema.json",
  "title": "Delight module status (status --json and $XDG_RUNTIME_DIR/omarchy-delight/status/<id>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "state", "title", "subtitle", "icon", "toggle", "actions", "devices", "reason", "updated"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "state": { "enum": ["on", "off", "busy", "needs-setup", "unsupported", "error"] },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "icon": { "type": "string" },
    "toggle": { "type": "boolean", "description": "Whether clicking the tile runs `delight <id> toggle`." },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "command"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "icon": { "type": "string" },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "devices": { "type": "array", "items": { "$ref": "device.schema.json#/$defs/device" } },
    "reason": { "type": ["string", "null"] },
    "updated": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["unsupported", "error"] } } },
      "then": { "properties": { "reason": { "type": "string", "minLength": 1 } } }
    }
  ]
}
