{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hiresello/omarchy-delight/schema/share-target.schema.json",
  "title": "Share targets (delight-<id> share-targets --json)",
  "type": "array",
  "items": { "$ref": "#/$defs/shareTarget" },
  "$defs": {
    "shareTarget": {
      "type": "object",
      "required": ["id", "label", "icon", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "description": "Added by `delight share-targets`." }
      }
    }
  }
}
